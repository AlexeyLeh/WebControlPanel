#!/bin/sh

SCRIPTDIR=$(dirname "$0")
. ${SCRIPTDIR}/script.sh

echo -e "Content-Type: text/html; charset=UTF-8\n\n"
echo -e "<!DOCTYPE html>\n\n"
echo "<html><head>"

cat ${SCRIPTDIR}/page.html

cat << EOF
<script>
const MODE_TITLE = '${MODE_TITLE}';
const WCPVER_TITLE = '${WCPVER_TITLE}';
//const STATUSFNAME = '${STATUSFNAME}';
</script>
EOF

echo "<script>"
cat ${SCRIPTDIR}/script.js
echo "</script>"

echo "</body></html>"
