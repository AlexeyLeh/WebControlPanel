#!/bin/sh

BINDIR="/root/bin"
FIRMWARE_NAME="esz7"

LOG_FILE_SETUP="/var/log/${FIRMWARE_NAME}-setup.log"
LOG_FILE_FWUPDATE="/var/log/${FIRMWARE_NAME}-update.log"
LOG_FILE_MAX_SIZE=10240

MODE="ATLAS"
MODE_TITLE="ББИ АТЛАС"
CFGNAME="atlas.cfg"
STATUSNAME="atlas.sts"
if [ -f ${BINDIR}/.APS ]; then
    MODE="SIU"
    MODE_TITLE="Sensors Interface Unit"
    CFGNAME="siu.cfg"
    STATUSNAME="siu.sts"
fi

CFGFILE="${BINDIR}/${CFGNAME}"
STATUSFILE="${BINDIR}/${STATUSNAME}"

get_uptime()
{
  UPTIME=$(awk '{
    ts = int($1)
    if (ts < 86400) {
        printf "%02d:%02d:%02d", ts/3600, (ts%3600)/60, ts%60
    } else if (int(ts/2592000) == 0) {
        printf "%d дн %02d:%02d:%02d", (ts%2592000)/86400, ((ts%2592000)%86400)/3600, (((ts%2592000)%86400)%3600)/60, ((ts%2592000)%86400)%60
    } else {
        printf "%d мес %d дн %02d:%02d:%02d", ts/2592000, (ts%2592000)/86400, ((ts%2592000)%86400)/3600, (((ts%2592000)%86400)%3600)/60, ((ts%2592000)%86400)%60
    }
  }' /proc/uptime)
}

get_system_time()
{
    DATE=$(date "+%d.%m.%Y %H:%M:%S")
    TIMEZONE=$(cat /etc/timezone 2>/dev/null || echo "UTC")
    SYS_TIME="$DATE &nbsp;&nbsp; [$TIMEZONE]"
}


set_system_time()
{
    # запрос на синхронизацию времени
    echo "Content-type: text/plain; charset=utf-8"
    echo ""

    touch ${LOG_FILE_SETUP}
    tail -c ${LOG_FILE_MAX_SIZE} ${LOG_FILE_SETUP} > ${LOG_FILE_SETUP}.tmp
    mv ${LOG_FILE_SETUP}.tmp ${LOG_FILE_SETUP} &>/dev/null

    get_system_time
    echo "${DATE}" >> ${LOG_FILE_SETUP}

    # Очищаем от потенциально опасных символов (оставляем только цифры и точку)
    RAW_TIME=$(echo "$QUERY_STRING" | sed 's/set_time=//')
    CLEAN_TIME=$(echo "$RAW_TIME" | sed 's/[^0-9.]//g')
    echo "CLEAN_TIME:   $CLEAN_TIME" >> /var/log/esz7-err.log

    # Проверяем, что строка не пустая и соответствует базовой длине формата
    if [ -n "$CLEAN_TIME" ] && [ ${#CLEAN_TIME} -ge 12 ]; then

        if date -s "$CLEAN_TIME" > /dev/null 2>&1; then
            echo "${DATE} SET DATE/TIME: $CLEAN_TIME" >> ${LOG_FILE_SETUP}
            hwclock -w -u &>/dev/null
            # Возвращаем новое время обратно
            get_system_time
            echo "$DATE<br>[$TIMEZONE]"
        else
            echo "${DATE} SET DATE/TIME TO '$CLEAN_TIME' FAILED" >> ${LOG_FILE_SETUP}
            echo "ERR_SET_DATE_FAILED"
        fi
    else
        echo "ERR_INVALID_FORMAT"
    fi
}

api_get_setup()
{
    echo "Content-type: application/json"
    echo ""
    # Читается вывод /bin/setup/ и формируется JSON-строка
    STR=$(setup)
    IP=$(echo   "$STR" | grep "ip:"      | awk '{print $2}')
    GW=$(echo   "$STR" | grep "gateway:" | awk '{print $2}')
    MAC=$(echo  "$STR" | grep "mac:"     | awk '{print $2}')
    SSH=$(echo  "$STR" | grep "ssh:"     | awk '{print $2}')
    FTP=$(echo  "$STR" | grep "ftp:"     | awk '{print $2}')
    HTTP=$(echo "$STR" | grep "http:"    | awk '{print $2}')
    LANG=$(echo "$STR" | grep "lang:"    | awk '{print $2}')
    SNO=$(echo  "$STR" | grep "serial:"  | awk '{print $2}')

    echo "{\"ip\":\"$IP\",\"mac\":\"$MAC\",\"gateway\":\"$GW\",\"ssh\":\"$SSH\",\"ftp\":\"$FTP\",\"http\":\"$HTTP\",\"lang\":\"$LANG\",\"serial\":\"$SNO\"}"
}

api_save_setup()
{
    read -n $CONTENT_LENGTH POST_DATA

    # Декодирование параметров (простая замена %XX символов, если требуется)
    # и получение переменные ip, gw, mac, ssh, ftp, http, lang, sno
    NEW_IP=$(echo   "$POST_DATA" | grep -oE 'ip=[^&]+'   | cut -d= -f2)
    NEW_GW=$(echo   "$POST_DATA" | grep -oE 'gw=[^&]+'   | cut -d= -f2)
    NEW_MAC=$(echo  "$POST_DATA" | grep -oE 'mac=[^&]+'  | cut -d= -f2 | sed 's/%3A/:/g') # замена url-encoded двоеточий
    NEW_SSH=$(echo  "$POST_DATA" | grep -oE 'ssh=[^&]+'  | cut -d= -f2)
    NEW_FTP=$(echo  "$POST_DATA" | grep -oE 'ftp=[^&]+'  | cut -d= -f2)
    NEW_HTTP=$(echo "$POST_DATA" | grep -oE 'http=[^&]+' | cut -d= -f2)
    NEW_LANG=$(echo "$POST_DATA" | grep -oE 'lang=[^&]+' | cut -d= -f2)
    NEW_SNO=$(echo  "$POST_DATA" | grep -oE 'sno=[^&]+'  | cut -d= -f2)

    # Последовательно вызываем утилиту setup для каждого параметра
    setup \
        --ip   "$NEW_IP"   \
        --www \
        --gw   "$NEW_GW"   \
        --mac  "$NEW_MAC"  \
        --ssh  "$NEW_SSH"  \
        --ftp  "$NEW_FTP"  \
        --http "$NEW_HTTP" \
        --lang "$NEW_LANG" \
        --sno  "$NEW_SNO" &>/dev/null
}

save_binary()
{
    BINFILE="$1"
    TARGETFILE="$2"
    BINFILE_SIZE=$(wc -c < $BINFILE)

    # Ищем смещение первой пустой строки (конец заголовка)
    # Переводим в десятичный вид
    HEADER_SIZE=$(head -c 512 "$BINFILE" | hexdump -v -e '/1 "%02x "' | awk '{
        idx = index($0, "0d 0a 0d 0a")
        if (idx > 0) {
            print (idx - 1) / 3 + 4
            exit
        }
    }')


    BOUNDARY="${CONTENT_TYPE#*boundary=}"
    BOUNDARY_LEN=$(printf "%s" "$BOUNDARY" | wc -c)
    TAIL_SIZE=$((BOUNDARY_LEN + 8))
    FIRMWARE_SIZE=$((BINFILE_SIZE - HEADER_SIZE - TAIL_SIZE))
    SKIP_LEN=$((HEADER_SIZE + 1))

    printf "FILE:          %s\n"    "${BINFILE}"       >> ${LOG_FILE_FWUPDATE}
    printf "SIZE:          %012d\n" "${BINFILE_SIZE}"  >> ${LOG_FILE_FWUPDATE}
    printf "HEADER SIZE:   %012d\n" "${HEADER_SIZE}"   >> ${LOG_FILE_FWUPDATE}
    printf "TAIL SIZE:     %012d\n" "${TAIL_SIZE}"     >> ${LOG_FILE_FWUPDATE}
    printf "FIRMWARE SIZE: %012d\n" "${FIRMWARE_SIZE}" >> ${LOG_FILE_FWUPDATE}
    printf "BOUNDARY:      %s\n"    "${BOUNDARY}"      >> ${LOG_FILE_FWUPDATE}

    tail -c +"${SKIP_LEN}" "${BINFILE}" | head -c -"${TAIL_SIZE}" > "${TARGETFILE}"
}

#-----------------------------------------------------------
# Main()
#
# 1. API РОУТЕР ДЛЯ AJAX
# Этот блок обрабатывает фоновые запросы и сразу завершает скрипт через exit 0
#

if [ "$QUERY_STRING" == "api_get_status" ]; then
    get_system_time
    SYS_TIME="$DATE<br>[$TIMEZONE]"
    get_uptime

    SERIAL=$(cat /etc/serialno 2>/dev/null || echo "N/A")
    SYSTEM=$(cat /etc/os-release 2>/dev/null | grep PRETTY_NAME | cut -d"=" -f 2 | sed s/\"//g || echo "Unknown")
    OS=$(uname -a)
    IPADR=$(ip addr show 2>/dev/null | awk '/inet / {print$2}' | cut -d '/' -f 1 | head -n 1)

    STR=$(${BINDIR}/esz7-ctrl version 2>/dev/null)
    ESZ7VER=$(echo "$STR" | cut -d'[' -f 1 | tr -d '\n')
    [ -z "$ESZ7VER" ] && ESZ7VER="[no firmware]"

    STATUS="STOP"
    STR=$(${BINDIR}/esz7-ctrl status 2>/dev/null)
    ESZ7=$(${BINDIR}/esz7-ctrl status 2>/dev/null | grep esz7 | head -n 1)
    if echo ${STR} | grep esz7; then
        STATUS="RUN"
        TASKS=$(echo "$STR" | sed ':a;N;$!ba;s/\n/<br>/g')
    fi

    echo "Content-Type: text/plain; charset=UTF-8"
    echo ""
    echo "${MODE}|||${SYS_TIME}|||${UPTIME}|||${SERIAL}|||${IPADR}|||${ESZ7VER}|||${STATUS}|||${SYSTEM}|||${OS}|||${TASKS}|||${CFGNAME}"
    exit 0

elif echo "$QUERY_STRING" | grep -q "set_time"; then
    set_system_time
    exit 0

elif [ "$QUERY_STRING" == "api_get_config_files" ]; then
    echo "Content-Type: text/plain; charset=UTF-8"
    echo ""
    cat "${CFGFILE}" 2>/dev/null
    echo "===CONTENT_SEPARATOR==="
    cat "${STATUSFILE}" 2>/dev/null
    exit 0

elif [ "$QUERY_STRING" == "api_action_start" ]; then
    if ! "$(${BINDIR}/esz7-ctrl status 2>/dev/null)" ; then
        ${BINDIR}/esz7-ctrl start >/dev/null 2>&1
    fi
    echo "Content-Type: text/plain"
    echo ""
    echo "RUN"
    exit 0

elif [ "$QUERY_STRING" == "api_action_restart" ]; then
    ${BINDIR}/esz7-ctrl restart >/dev/null 2>&1
    echo "Content-Type: text/plain"
    echo ""
    echo "RESTART"
    exit 0

elif [ "$QUERY_STRING" == "api_action_stop" ]; then
    ${BINDIR}/esz7-ctrl stop >/dev/null 2>&1
    echo "Content-Type: text/plain"
    echo ""
    echo "STOP"
    exit 0

elif [ "$QUERY_STRING" == "api_action_reboot" ]; then
    echo "Content-Type: text/plain"
    echo ""
    echo "REBOOTING"
    (sleep 1; reboot) &
    exit 0

elif [ "$QUERY_STRING" == "api_save_config" ]; then
    if [ -n "$CONTENT_LENGTH" ] && [ "$CONTENT_LENGTH" -gt 0 ]; then
        POST_DATA=$(dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null)
    fi

    # Переводим POST_DATA в привычный DECODED_DATA
    DECODED_DATA=$(printf '%b' "$(echo "$POST_DATA" | sed 's/%/\\x/g')")
echo "DECODED_DATA: $DECODED_DATA" > /tmp/x.log
    # основные поля (NL - с новой строки выводить поле)
    if [ "$MODE" == "ATLAS" ]; then
        FIELDS="host1 port11 port12 NL host2 port21 port22 NL host3 port31 port32 NL channels"
    else
        FIELDS="ads_cmd_port ads_data_port NL ss_cmd_port ss_dats_port NL dtr_cmd_port dtr_data_port NL wits_port NL channels NL SystemUnits Decimal"
    fi

    # Временные файлы для сборки
    head="${CFGFILE}.head"
    body="${CFGFILE}.body"
    tail="${CFGFILE}.tail"
    all_params="${CFGFILE}.params"

    # разделение на части (head и tail)
    awk '/^#/ && !done { print; next } { done=1 }' "${CFGFILE}" > "${head}"
    awk '/DO NOT EDIT/ { done=1 } done { print }'  "${CFGFILE}" > "${tail}"

    # извлечение всех активных параметров из исходного body
    head_lines=$(wc -l < "${head}")
    awk -v skip="${head_lines}" '
        NR <= skip { next }
        /DO NOT EDIT/ { exit }
        /^[[:space:]]*#/ { next } 
        NF == 0 { next }
        {
            idx = index($0, "=")
            if (idx > 0) {
                key = substr($0, 1, idx - 1)
                rest = substr($0, idx + 1)
                gsub(/^[ \t]+|[ \t]+$/, "", key)
                gsub(/^[ \t]+/, "", rest)
                print key "=" rest
            }
        }' "${CFGFILE}" > "${all_params}"

    # сборка нового переупорядоченного body
    # сначала выдергиваем поля из списка FIELDS в строгом порядке
    > "${body}"
    for field in $FIELDS; do
        [ "$field" == "NL" ] && echo "" >> "${body}" && continue;
        line=$(grep "^${field}=" "${all_params}")
        if [ -n "$line" ]; then
            echo "$line" >> "${body}"
        else
            echo "${field}=" >> "${body}"
        fi
    done

    # Добавляем остальные поля, которых НЕ БЫЛО в списке FIELDS
    echo -e "\n#---\n" >> "${body}"
    while read -r line; do
        [ -z "$line" ] && continue
        case "$line" in
            \#*|"") continue ;;
        esac

        key="${line%%=*}"
        is_main=0
        for main_field in $FIELDS; do
            if [ "$key" = "$main_field" ]; then
                is_main=1
                break
            fi
        done

        if [ $is_main -eq 0 ]; then
            echo "$line" >> "${body}"
        fi
    done < "${all_params}"

    # обновление body из данных html-формы (decoded_data)
    echo "$DECODED_DATA" | tr '&' '\n' | while read -r pair; do
        [ -z "$pair" ] && continue
        key="${pair%%=*}"
        value="${pair#*=}"

        [ -z "$key" ] && continue
        [ "$key" = "action" ] && continue

        # декодирование %2C в запятую для поля channels в DECODED_DATA
        if [ "$key" = "channels" ]; then
            value=$(echo "$value" | sed 's/%2[cC]/,/g')
        elif [ "$key" = "proto_ver" ]; then
            if [ -z "$value" ]; then
                value="1"
            fi
        fi

        if grep -q "^${key}=" "${body}"; then
            if grep "^${key}=" "${body}" | grep -q "#"; then
                sed "s|^\(${key}=\)[^#]*\(.*\)|\1${value}\2|" "${body}" > "${body}.tmp"
            else
                sed "s|^\(${key}=\).*|\1${value}|" "${body}" > "${body}.tmp"
            fi
            mv "${body}.tmp" "${body}"
        else
            # Если поля нет в body, но это валидный параметр — дописываем
            # Для SIU проверяем, относится ли поле к конфигурации (исключаем технические переменные формы)
            if [ "$MODE" == "ATLAS" ]; then
                case "$key" in
                    host1|port11|port12|host2|port21|port22|host3|port31|port32|channels|proto_ver)
                        echo "${key}=${value}" >> "${body}" ;;
                esac
            else
                case "$key" in
                    ads_cmd_port|ads_data_port|ss_cmd_port|ss_dats_port|dtr_cmd_port|dtr_data_port|wits_port|SystemUnits|Decimal|channels)
                        echo "${key}=${value}" >> "${body}" ;;
                esac
            fi
        fi
    done

    # выравнивание комментариев (24 символа)
    awk -F= '
        NF == 0 || $0 == "" { print ""; next }
        /^[[:space:]]*#/ { print; next }
        {
            if (NF < 2) { print; next }
            idx = index($0, "#")
            if (idx > 0) {
                rest = substr($0, idx)
                idx_in_val = index($2, "#")
                val = substr($2, 1, idx_in_val - 1)
                rest = "        " rest
            } else {
                val = $2
                rest = ""
            }
            gsub(/^[ \t]+|[ \t]+$/, "", val)
            gsub(/^[ \t]+|[ \t]+$/, "", $1)
            left = $1 "=" val
            if (length(left) < 24) {
                printf "%-24s%s\n", left, rest
            } else {
                print left rest
            }
        }' "${body}" > "${body}.clean"
    mv "${body}.clean" "${body}"

    # сборка итогового файла и обновление даты 
    cat "${head}" "${body}" > "${CFGFILE}.new"
    echo "" >> "${CFGFILE}.new"
    cat "${tail}" >> "${CFGFILE}.new"

    current_date=$(date "+%c")

    awk -v d="# Updated: ${current_date}" '
    NR==1 {
        if ($0 ~ /^# *Updated:/) { print d; next } 
        else { print d; print $0; next }
    } 
    {print}' "${CFGFILE}.new" > "${CFGFILE}"


    # удаление временных файлов
    rm -f "${head}" "${body}" "${tail}" "${all_params}" "${CFGFILE}.new"

    # Отдаем браузеру SUCCESS в формате plain-text для AJAX
    echo "Content-Type: text/plain"
    echo ""
    echo "SUCCESS"
    exit 0

elif [ "$QUERY_STRING" == "_api_save_config" ]; then
    if [ -n "$CONTENT_LENGTH" ] && [ "$CONTENT_LENGTH" -gt 0 ]; then
        POST_DATA=$(dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null)
    fi

    get_param() {
        echo "$POST_DATA"   | \
            tr '&' '\n'     | \
            grep "^$1="     | \
            cut -d'=' -f2   | \
            sed 's/+/ /g; s/%2[cC]/,/g; s/%\([0-9A-F][0-9A-F]\)/\\x\1/g' | \
            xargs echo -e 2>/dev/null
    }

    update_cfg_param() {
        Key="$1"
        Val="$2"
        if grep -q "^[[:space:]]*$Key=" "$CFGFILE"; then
            sed -i "s|^[[:space:]]*$Key=.*|$Key=$Val|" "$CFGFILE"
        else
            echo "$Key=$Val" >> "$CFGFILE"
        fi
    }

    if [ "$MODE" == "ATLAS" ]; then
        update_cfg_param "host1"         "$(get_param host1)"
        update_cfg_param "port11"        "$(get_param port11)"
        update_cfg_param "port12"        "$(get_param port12)"
        update_cfg_param "host2"         "$(get_param host2)"
        update_cfg_param "port21"        "$(get_param port21)"
        update_cfg_param "port22"        "$(get_param port22)"
        update_cfg_param "host3"         "$(get_param host3)"
        update_cfg_param "port31"        "$(get_param port31)"
        update_cfg_param "port32"        "$(get_param port32)"
        update_cfg_param "proto_ver"     "$(get_param proto_ver)"
        update_cfg_param "channels"      "$(get_param channels)"
    else
        update_cfg_param "ads_cmd_port"  "$(get_param ads_cmd_port)"
        update_cfg_param "ads_data_port" "$(get_param ads_data_port)"
        update_cfg_param "ss_cmd_port"   "$(get_param ss_cmd_port)"
        update_cfg_param "ss_dats_port"  "$(get_param ss_dats_port)"
        update_cfg_param "dtr_cmd_port"  "$(get_param dtr_cmd_port)"
        update_cfg_param "dtr_data_port" "$(get_param dtr_data_port)"
        update_cfg_param "wits_port"     "$(get_param wits_port)"
        update_cfg_param "SystemUnits"   "$(get_param SystemUnits)"
        update_cfg_param "Decimal"       "$(get_param Decimal)"
        update_cfg_param "channels"      "$(get_param channels)"
    fi
    
    echo "Content-Type: text/plain"
    echo ""
    echo "SUCCESS"
    exit 0

elif [ "$QUERY_STRING" = "api_get_setup" ]; then
    api_get_setup
    exit 0

elif [ "$QUERY_STRING" = "api_save_setup" ]; then
    api_save_setup
    echo "Content-type: text/plain"
    echo ""
    echo "SUCCESS"
    exit 0

elif [ "$QUERY_STRING" = "action=check_app_status" ]; then
    echo "Content-type: text/plain; charset=utf-8"
    echo ""
    STR=$(${BINDIR}/esz7-ctrl status 2>/dev/null)
    if [ ! -z "$STR" ]; then
        echo "RUNNING"
    else
        echo "STOPPED"
    fi
    exit 0

elif echo "$QUERY_STRING" | grep -q "action=uploadfw"; then
    echo "Content-type: text/plain; charset=utf-8"
    echo ""

    touch ${LOG_FILE_FWUPDATE}
    tail -c ${LOG_FILE_MAX_SIZE} ${LOG_FILE_FWUPDATE} >> "${LOG_FILE_FWUPDATE}.tmp"
    mv ${LOG_FILE_FWUPDATE}.tmp ${LOG_FILE_FWUPDATE} &>/dev/null
    get_system_time
    echo "${DATE}" >> ${LOG_FILE_FWUPDATE}

    # проверка остановки текущего процесса
    STR=$(${BINDIR}/esz7-ctrl status 2>/dev/null)
    if [ ! -z "$STR" ]; then
        echo "ERR_APP_NOT_STOP"
        exit 0
    fi

    RAW_HASH=$(echo "$QUERY_STRING" | sed -n 's/.*expected_hash=\([^&]*\).*/\1/p')
    EXPECTED_HASH=$(echo "$RAW_HASH" | tr 'A-Z' 'a-z' | sed 's/[^a-f0-9]//g')
    if [ ${#EXPECTED_HASH} -ne 64 ]; then
        echo "ERR_BAD_EXPECTED_HASH"
        exit 0
    fi


    STASHDIR="${BINDIR}/fw"
    mkdir -p ${STASHDIR}

    RAWFILE="${STASHDIR}/${FIRMWARE_NAME}.raw"      # Временный файл
    FIRMWARE="${BINDIR}/${FIRMWARE_NAME}"           # Файл текущей прошивки
    FIRMWARE_NEW="${STASHDIR}/${FIRMWARE_NAME}-new" # Файл новой прошивки

    # Читаем бинарное тело POST-запроса заданной длины из стандартного ввода (stdin)
    if [ ! -z "$CONTENT_LENGTH" ] && [ "$CONTENT_LENGTH" -gt 0 ]; then
        head -c "$CONTENT_LENGTH" > "${RAWFILE}"
    else
        echo "ERR_EMPTY_CONTENT"
        exit 0
    fi

    # CONTENT_TYPE is expecting
    echo "CONTENT_LENGTH: $CONTENT_LENGTH" >> ${LOG_FILE_FWUPDATE}
    save_binary ${RAWFILE} ${FIRMWARE_NEW}

    rm -f "$RAWFILE"

    if [ ! -f "$FIRMWARE_NEW" ]; then
        rm -f "$RAWFILE"
        echo "ERROR: \"$FIRMWARE_NEW\" NOT SAVED" >> ${LOG_FILE_FWUPDATE}
        echo "ERR_FILE_NOT_SAVED"
        exit 0
    fi

    CALCULATED_HASH=$(sha256sum -b "$FIRMWARE_NEW" | awk '{print $1}')
    echo "HASH:          $CALCULATED_HASH" >> ${LOG_FILE_FWUPDATE}
    echo "EXPECTED HASH: $EXPECTED_HASH"   >> ${LOG_FILE_FWUPDATE}

    if [ "$CALCULATED_HASH" = "$EXPECTED_HASH" ]; then
        echo "HASH OK" >> ${LOG_FILE_FWUPDATE}

        # сохранение предыдущей версии
        if [ -f "${FIRMWARE}" ]; then
            DATE=$(date "+%Y%m%d-%H%M%S")
            echo -n "BACKUP:        " >> ${LOG_FILE_FWUPDATE}
            cp -fv "${FIRMWARE}" "${FIRMWARE}-${DATE}" >> ${LOG_FILE_FWUPDATE} 2>&1
            if [ "$?" -ne 0 ]; then
                echo -e "BACKUP FAILED\nCANCEL" >> ${LOG_FILE_FWUPDATE}
                echo "" >> ${LOG_FILE_FWUPDATE}
                echo "ERR_BACKUP_FAILED"
                exit 0
            fi
        fi

        # замена текущей прошивки
        echo -n "UDPATE:        " >> ${LOG_FILE_FWUPDATE}
        cp -fv "${FIRMWARE_NEW}" "${FIRMWARE}" >> ${LOG_FILE_FWUPDATE} 2>&1
        if [ "$?" -ne 0 ]; then
            echo "UPDATE FAILED" >> ${LOG_FILE_FWUPDATE}
            echo "" >> ${LOG_FILE_FWUPDATE}
            echo "ERR_UPDATE_FAILED"
            exit 0
        fi

        echo -n "SET EXEC BIT   " >> ${LOG_FILE_FWUPDATE}
        chmod -v 500 "${FIRMWARE}" >> ${LOG_FILE_FWUPDATE}
        echo "" >> ${LOG_FILE_FWUPDATE}
        echo "SUCCESS"
        exit 0
    fi

    echo "HASH MISMATCHED - UPDATE CANCELED" >> ${LOG_FILE_FWUPDATE}
    echo "" >> ${LOG_FILE_FWUPDATE}

    rm -f "$FIRMWARE_NEW"
    echo "ERR_HASH_MISMATCH"
    exit 0
fi


# 2. Сюда попадаем, если query_string не совпало ни с одним api - генерирует html
echo "Content-Type: text/html; charset=UTF-8"
echo ""

# 3.1 - заголовок, стили и компактное меню

cat << EOF
<!DOCTYPE html>

<html>
<head>
